# Copie para backend/.env.local e preencha.

# Caminho da chave da conta de servico do Firebase (relativo a pasta backend).
# Gere em: Firebase Console > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Alternativa para hospedagem: o JSON inteiro da chave numa unica linha (tem prioridade sobre o caminho).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Client ID do Google OAuth (o mesmo usado no frontend), usado para validar o login com Google.
GOOGLE_CLIENT_ID=564328782086-14nq74v0b6fsvl4gi9senu50thflplv5.apps.googleusercontent.com
